{
  "name": "quizzlet-thor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p . && tsc -p e2e",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/react": "^6.18.6",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "2.8.2",
    "@vercel/global-config": "^1.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.1",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
