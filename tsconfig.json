// Server side: Vercel Functions (api/), shared server code and the Vite config.
// The browser app has its own config in src/tsconfig.json.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "api",
    "server",
    "vite.config.ts"
  ]
}
